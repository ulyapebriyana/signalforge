PORT=4173
SCAN_INTERVAL_SECONDS=15
ENABLE_ALERTS=true
# Preset untuk deteksi status di UI. Alert Telegram memakai SEMUA preset,
# masing-masing dengan ambang dan cooldown-nya sendiri.
SCANNER_PRESET=yanman
# Token bot dari @BotFather. Boleh dikosongkan: kalau kosong, tokennya bisa
# ditempel langsung dari dashboard (Pengaturan -> Telegram) dan disimpan di
# data/telegram.json.
TELEGRAM_BOT_TOKEN=
# Tidak perlu lagi. Channel/chat penerima dihubungkan dari dashboard: tekan
# "Hubungkan channel", lalu Start di bot (chat pribadi) atau jadikan botnya
# admin (channel/grup). Diisi hanya kalau ingin satu chat tetap dipaksa dari
# server; chat itu tidak bisa diputus dari dashboard.
TELEGRAM_CHAT_ID=
GMGN_API_KEY=

# Pelacakan posisi LP. Meteora tidak punya endpoint posisi per wallet, jadi
# posisi dibaca langsung dari chain lewat RPC. Hanya alamat publik yang dipakai;
# server ini tidak pernah menandatangani apa pun dan tidak menyimpan private key.
# Helius: https://mainnet.helius-rpc.com/?api-key=ISI_API_KEY_ANDA
SOLANA_RPC_URL=
# Wallet yang dipantau di latar belakang untuk alert keluar-range, dipisah koma.
# Wallet yang diketik di dashboard tetap bisa dibaca tanpa masuk daftar ini.
LP_WALLETS=
LP_SCAN_SECONDS=60
